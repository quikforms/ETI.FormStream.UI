# Compiled output — build output is scratch and ignored, EXCEPT the distributable bundle and its
# third-party license notices, which are committed at each release so they can be served from the
# public repo via CDN (jsDelivr).
/dist/*
!/dist/formstream/
/dist/formstream/*
!/dist/formstream/formstream-bundle.js
!/dist/formstream/3rdpartylicenses.txt
/out-tsc

# Dependencies
/node_modules

# Angular build cache
/.angular/cache

# IDEs and editors
/.vscode
/.idea
/.vs

# Logs
*.log
npm-debug.log*

# System files
.DS_Store
Thumbs.db
